{
  "name": "dmcgrid-platform",
  "version": "0.1.0",
  "private": true,
  "description": "DMCGrid Platform — The operating network for modern B2B travel sourcing",
  "scripts": {
    "build": "pnpm -r --filter \"@dmcgrid/*\" run build",
