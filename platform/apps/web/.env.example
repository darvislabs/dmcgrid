# Supabase (local: `supabase start` prints both keys; never expose the service key to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
# Server-only — Server Actions / SECURITY DEFINER helpers. NEVER prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
# App origin used in magic links and share URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Demo OTP shortcut on the login page (non-production builds only)
NEXT_PUBLIC_DEMO_MODE=true
# One-click instant sign-in buttons on /login (non-production convenience)
NEXT_PUBLIC_DEV_LOGIN=true
